APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

CONTROL_CENTER_ADMIN_EMAIL=

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Base MySQL dédiée aux tests de migration provisioning (TASK 336+) — distincte de la base de dev principale
# PROVISIONING_TEST_DB_HOST=127.0.0.1
# PROVISIONING_TEST_DB_PORT=3306
# PROVISIONING_TEST_DB_DATABASE=mkdpro_control_provisioning_test
# PROVISIONING_TEST_DB_USERNAME=root
# PROVISIONING_TEST_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Production (exemples — ne pas committer de secrets réels)
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://control-center.example.test
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=mkd_pro_control_center
# DB_USERNAME=
# DB_PASSWORD=
# MAIL_MAILER=smtp
# QUEUE_CONNECTION=database
# CACHE_STORE=database
# FILESYSTEM_DISK=local

# Abonnements — renouvellement automatique par crédit (Tasks 272–277) — désactivé par défaut
SUBSCRIPTION_AUTOMATIC_CREDIT_RENEWAL_ENABLED=false

# Provisioning — o2switch hosting (TASK 357) — désactivé par défaut, aucun appel réseau
PROVISIONING_O2SWITCH_HOSTING_ENABLED=false
PROVISIONING_O2SWITCH_HOSTING_DRY_RUN=false
PROVISIONING_O2SWITCH_ACCOUNT_LOGICAL_ID=
PROVISIONING_O2SWITCH_ENVIRONMENT=production

# Provisioning — o2switch MySQL (TASK 359) — désactivé par défaut
PROVISIONING_O2SWITCH_DATABASE_ENABLED=false
PROVISIONING_O2SWITCH_DATABASE_DRY_RUN=false
PROVISIONING_O2SWITCH_DATABASE_NAME_PREFIX=
PROVISIONING_O2SWITCH_MYSQL_HOST_LOGICAL=localhost
PROVISIONING_O2SWITCH_CPANEL_HOST=

# Provisioning — déploiement Gestion o2switch (TASK 360) — désactivé par défaut
PROVISIONING_O2SWITCH_DEPLOY_ENABLED=false
PROVISIONING_O2SWITCH_DEPLOY_DRY_RUN=false
PROVISIONING_O2SWITCH_DEPLOYMENT_ROOT_BASE=
PROVISIONING_GESTION_GIT_REPOSITORY_URL=https://github.com/mkddanfakha/Gestion.git
PROVISIONING_GESTION_GIT_DEFAULT_REF=

# Provisioning — Environment Gestion o2switch (TASK 361) — désactivé par défaut
PROVISIONING_O2SWITCH_ENVIRONMENT_ENABLED=false
PROVISIONING_O2SWITCH_ENVIRONMENT_DRY_RUN=false
PROVISIONING_GESTION_APP_BASE_DOMAIN=
PROVISIONING_GESTION_APPLICATION_ENV=production
PROVISIONING_GESTION_APPLICATION_DEBUG=false

# Provisioning — dépendances Gestion o2switch (TASK 362) — désactivé par défaut
PROVISIONING_O2SWITCH_DEPENDENCIES_ENABLED=false
PROVISIONING_O2SWITCH_DEPENDENCIES_DRY_RUN=false

# Provisioning — build Vite Gestion o2switch (TASK 363) — désactivé par défaut
PROVISIONING_O2SWITCH_BUILD_ENABLED=false
PROVISIONING_O2SWITCH_BUILD_DRY_RUN=false

# Provisioning — migrations Laravel Gestion o2switch (TASK 364) — désactivé par défaut
PROVISIONING_O2SWITCH_MIGRATE_ENABLED=false
PROVISIONING_O2SWITCH_MIGRATE_DRY_RUN=false

# Provisioning — filesystem / storage Gestion o2switch (TASK 365) — désactivé par défaut
PROVISIONING_O2SWITCH_STORAGE_ENABLED=false
PROVISIONING_O2SWITCH_STORAGE_DRY_RUN=false

# Provisioning — cache Laravel Gestion o2switch (TASK 366) — désactivé par défaut
PROVISIONING_O2SWITCH_CACHE_ENABLED=false
PROVISIONING_O2SWITCH_CACHE_DRY_RUN=false

# Provisioning — bootstrap admin Gestion o2switch (TASK 367) — désactivé par défaut
PROVISIONING_O2SWITCH_ADMIN_ENABLED=false
PROVISIONING_O2SWITCH_ADMIN_DRY_RUN=false

# Provisioning — modules Gestion o2switch (TASK 368) — désactivé par défaut
PROVISIONING_O2SWITCH_MODULES_ENABLED=false
PROVISIONING_O2SWITCH_MODULES_DRY_RUN=false

# Provisioning — health Gestion o2switch (TASK 369) — désactivé par défaut
PROVISIONING_O2SWITCH_HEALTH_ENABLED=false
PROVISIONING_O2SWITCH_HEALTH_DRY_RUN=false

# Secrets futurs (vault/.env uniquement — ne jamais committer de valeur)
# PROVISIONING_O2SWITCH_API_TOKEN=
# PROVISIONING_O2SWITCH_SSH_USERNAME=
# PROVISIONING_O2SWITCH_CPANEL_USERNAME=

# Provisioning — Cloudflare DNS (TASK 358) — désactivé par défaut
PROVISIONING_CLOUDFLARE_DNS_ENABLED=false
PROVISIONING_CLOUDFLARE_DNS_DRY_RUN=false
PROVISIONING_CLOUDFLARE_ZONE_NAME=
PROVISIONING_CLOUDFLARE_ZONE_ID=
PROVISIONING_CLOUDFLARE_RECORD_TYPE=CNAME
PROVISIONING_CLOUDFLARE_RECORD_CONTENT=
# PROVISIONING_CLOUDFLARE_API_TOKEN=

# Préflight infrastructure read-only (TASK 375) — n'active pas le provisioning
# PROVISIONING_PREFLIGHT_HTTP_TIMEOUT=15
# PROVISIONING_PREFLIGHT_GIT_PROBE_ROOT=
# PROVISIONING_PREFLIGHT_FILEMAN_PROBE_DIR=
# PROVISIONING_PREFLIGHT_FILEMAN_PROBE_FILE=

# Rappels d'échéance (Tasks 281–286) — désactivés par défaut
SUBSCRIPTION_REMINDERS_ENABLED=false
SUBSCRIPTION_REMINDER_NOTIFICATIONS_ENABLED=false
SUBSCRIPTION_REMINDER_NOTIFICATION_CHANNEL=prepared
SUBSCRIPTION_REMINDER_ADMIN_EMAIL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
